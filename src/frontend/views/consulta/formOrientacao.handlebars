<h1 class="titulo">Orientação</h1>
<div id="container">
  <form id="form-orientacao" action="/consulta/CadastrarConsulta" method="post">
    <label for="descricao">Orientações ao paciente:</label>
    <textarea id="descricao" name="descricao" rows="6" required></textarea>
    <input type="hidden" name="dadosConsulta" id="dadosConsulta">

    <div class="navegacao">
      <button type="button" class="btn" onclick="history.back()">Voltar</button>
      <button type="submit" class="btn salvar">Salvar Consulta</button>
    </div>
  </form>
</div>
